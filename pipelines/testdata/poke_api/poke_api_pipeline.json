{
  "source" : {
    "type" : "rest",
    "rest" :{
      "base_url": "https://pokeapi.co/api/v2/pokemon?offset=1345&limit=4",
      "data": {
        "path" : "results",
        "is_array": true      
      },  
      "pagination": {
        "type": "cursor",
        "response": {
          "next": {
            "path": "next"
          }
        }
      }
    }
  },
  "transforms" : [
    { 
      "type":"extractor",
      "extractor": { 
        "fields": "fields_config"
      },
      "workers" : 5
    }
  ],
  "sink" : {
    "type" : "rdbs",
    "rdbs" : {
        "db_type" : "postgres",
        "dsn" : "postgres://username:password@localhost:5432/database_name?sslmode=disable",
        "table" : "pokemon",
        "schema" : "fields_config",
        "batch_size" : 10
    } 
  },

  "additional_configs": {
    "fields_config" : {
      "name": { "path": "name", "type": "string","required" : false, "default": "" },
      "url": { "path": "url", "type": "string", "required" : false, "default": "" }
    }
  }

}
