{
  "connector" : {
    "type" : "rest",
    "rest" :{
      "authentication" : {
        "type" : "query",
        "paramName" : "access_token"
      },
      "data": {
        "path" : "data",
        "is_array": true      
      },  
      "pagination": {
        "type": "cursor",
        "request": {
          "param": "after"
        },
        "response": {
          "next": {
            "path": "paging.cursors.after"
          }
        }
      }
    },
    "retry": {
      "max_retries": 3,
      "backoff_ms": 500,
      "max_backoff" : 500
    }    
  },
  "sink" : {
    "type" : "rdbs",
    "batch_size" : 10,
    "retry": {
      "max_retries": 3,
      "backoff_ms": 500,
      "max_backoff" : 500
    },
    "rdbs" : {
        "db_type" : "postgres",
        "dsn" : ""
       
    } 
  },

  "runtime": {
    "state_store": {
      "type" : "postgres",
      "name" : "pipeline_state",
      "auto_create": true,
      "source" : "source1"
    }
  },
  "sources" : {
    "source1": {
      "type": "postgres",
      "dsn" : "postgres://username:password@localhost:5432/database_name?sslmode=disable"         
    },
     "source2": {
      "type": "postgres",
      "dsn" : "postgres://username:password@localhost:5432/database_name?sslmode=disable"         
    }
  }

}
