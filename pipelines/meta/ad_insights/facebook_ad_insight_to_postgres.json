{
  "connector" : {
    "type" : "rest",
    "rest" :{
      "base_url": "xxx",
      "authentication" : {
        "type" : "query",
        "paramName" : "access_token"
      },
      "data": {
        "path" : "data",
        "is_array": true      
      },  
      "pagination": {
        "type": "cursor",
        "request": {
          "param": "after"
        },
        "response": {
          "next": {
            "path": "paging.cursors.after"
          }
        }
      }
    },
    "retry": {
      "max_retries": 3,
      "backoff_ms": 500,
      "max_backoff" : 500
    }
  },
  "transformers" : [
    { 
      "type":"extractor",
      "extractor": { 
        "fields": "fields_config"
      },
      "workers" : 5
    }
  ],
  "sink" : {
    "type" : "rdbs",
    "batch_size" : 10,
    "retry": {
      "max_retries": 3,
      "backoff_ms": 500,
      "max_backoff" : 500
    },
    "rdbs" : {
        "db_type" : "postgres",
        "dsn" : "",
        "table" : "",
        "schema" : "fields_config",
        "upsert" : "product_id,date_start"
       
    } 
  },

  "additional_configs": {
    "event_buffer_size" : 10,
    "fields_config" : {
      "spend": { "path": "spend", "type": "float","required" : false, "default": 0.0 },
      "clicks": { "path": "clicks", "type": "int", "required" : false, "default": 0 },
      "impressions": { "path": "impressions", "type": "int", "required" : false, "default": 0 },
      "product_id": { "path": "product_id", "type": "int", "required" : false, "default": 0 },
      "date_start": { "path": "date_start", "type": "time", "required" : false, "default": 0 }
    }
  }

}
