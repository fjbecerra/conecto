{
  "connector" : {
    "type" : "rest",
    "rest" :{
      "authentication" : {
        "type" : "query",
        "paramName" : "access_token"
      },
      "data": {
        "path" : "data",
        "is_array": true      
      },  
      "pagination": {
        "type": "cursor",
        "request": {
          "param": "after"
        },
        "response": {
          "next": {
            "path": "paging.cursors.after"
          }
        }
      }
    },
    "retry": {
      "max_retries": 3,
      "backoff_ms": 500,
      "max_backoff" : 500
    },
    "streams": {
      "ad_insights": {
        "base_url": "xxx",
        "schema": {
          "spend": { "path": "spend", "type": "float","required" : false, "default": 0.0 },
          "clicks": { "path": "clicks", "type": "int64", "required" : false, "default": 0 },
          "impressions": { "path": "impressions", "type": "int64", "required" : false, "default": 0 },
          "product_id": { "path": "product_id", "type": "int64", "required" : false, "default": 0 },
          "date_start": { "path": "date_start", "type": "int64", "required" : false, "default": null }
        },
        "destination": "ad_insights",
        "key_fields": ["product_id", "date_start"],
        "workers" : 5     
      }
    }
    
  },
  "sink" : {
    "type" : "rdbs",
    "batch_size" : 10,
    "retry": {
      "max_retries": 3,
      "backoff_ms": 500,
      "max_backoff" : 500
    },
    "rdbs" : {
        "db_type" : "postgres",
        "dsn" : ""
       
    } 
  },

  "runtime": {
    "state_store": {
      "type" : "postgres",
      "name" : "pipeline_state",
      "auto_create": true,
      "source" : "source1"
    }
  },
  "sources" : {
    "source1": {
      "type": "postgres",
      "dsn" : "postgres://username:password@localhost:5432/database_name?sslmode=disable"         
    },
     "source2": {
      "type": "postgres",
      "dsn" : "postgres://username:password@localhost:5432/database_name?sslmode=disable"         
    }
  }

}
