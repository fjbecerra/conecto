{
    "app": {
        "security": {
            "credential_encryption_key": "${CREDENTIAL_ENCRYPTION_KEY_V1}",
            "auth_state_signer_key": "${AUTH_STATE_SIGNER_KEY}"
        },
        "pipelines" : [
            {
                "provider" : "shopify",
                "path": "./config/pipelines/shopify.json"  
            }      
        ],
        
        "sync" : {
            "buffer" : {
                "type" : "queue",
                "size" : 100
            },
            "scheduler": {
                "duration" : "1s"
            },
             "retry": {
                "max_retries": 3,
                "backoff_ms": 500,
                "max_backoff" : 500
            }
        },
        
        "store": {
            "type" : "postgres",
            "client": {
                 "dsn" : "postgres://${POSTGRES_1_DB_NAME}:${POSTGRES_1_DB_PASSWORD}@localhost:5432/database_name?sslmode=disable"
            }
        },
        
        "resources" : [
            {
                "name": "postgres_1",
                "type": "postgres",
                "client" : {
                    "dsn" : "postgres://${POSTGRES_1_DB_NAME}:${POSTGRES_1_DB_PASSWORD}@localhost:5432/database_name?sslmode=disable"
                },
                "retry": {
                    "max_retries": 3,
                    "backoff_ms": 500,
                    "max_backoff" : 500
                }                    
            },
            {
                "name" : "memory_1",
                "type": "memory"
            },
            {
                "name": "shopify_1",
                "type": "shopify",
                "config": {
                    "app_url" : "https://9310-2a0a-ef40-866-6b01-3503-88cb-ea9e-c4ce.ngrok-free.app",
                    "client_id": "06df04d35be21f9bfc0987849a2f4f66",
                    "client_secret": "${SHOPIFY_SECRET}",
                    "scopes": ["read_products"]
                },
                "client": {
                    "timeout_ms": 5000,
                    "max_idle_connections": 10,
                    "max_idle_connections_per_host": 10,
                    "idle_connection_timeout_ms":  1000
                },
                "retry": {
                    "max_retries": 3,
                    "backoff_ms": 500,
                    "max_backoff" : 500
                }

            }
        ],

        "http_server" : {
            "port" : 8089
        }
    }
}