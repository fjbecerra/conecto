{
    "app": {
        "pipeline_registry" : [  
            "./config/pipelines/shopify.json"        
        ],
        
        "sync" : {
            "buffer" : {
                "type" : "queue",
                "size" : 100
            },
            "scheduler": {
                "duration" : "1s"
            },
             "retry": {
                "max_retries": 3,
                "backoff_ms": 500,
                "max_backoff" : 500
            }
        },
        
        "db": {
            "source" : "source1"
        },
        
        "sources" : {
            "source1": {
                "type": "postgres",
                "dsn" : "postgres://username:password@localhost:5432/database_name?sslmode=disable"         
            },
            "source2": {
                "type": "postgres",
                "dsn" : "postgres://username:password@localhost:5432/database_name?sslmode=disable"         
            },
            "memory": {
                "type": "memory"
            },
            "http_client": {
                "type": "http",
                "timeout_ms": 5000,
                "max_idle_connections": 10,
                "max_idle_connections_per_host": 10
            }
        },

        "http_server" : {
            "port" : 8089
        }
    }
}