{
    "streams":[
        {
            "name" : "products",
            "fields_specs": {               
                    "id": { "path": "id", "type": "string","required" : true, "default": null },
                    "title": { "path": "title", "type": "string","required" : false, "default": null },
                    "createdAt": { "path": "createdAt", "type": "string","required" : false, "default": null },   
                    "updatedAt": { "path": "updatedAt", "type": "string","required" : false, "default": null }                
            },
            "connector":{
                "resource": "shopify_1",                
                 "config": {
                    "batch_size": 10,
                    "sync": {
                        "incremental_last_n_days": 2
                    }
                }             
            },
            "sink" : {  
                "resource": "postgres_1",
                "config":{
                    "table" : "shopify_products",
                    "auto_create": true
                }
            }            
        }
    ]
}
