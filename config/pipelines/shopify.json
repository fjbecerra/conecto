{
    "id" : "shopify",
    "authorize": {
        "type" : "oauth",
        "oauth":{
            "app_url" : "https://0bd2-2a0a-ef40-866-6b01-1ddb-c2b2-864f-ba0a.ngrok-free.app",
            "client_id": "06df04d35be21f9bfc0987849a2f4f66",
            "client_secret": "SHOPIFY_SECRET",
            "scopes": ["read_orders"]
        }        
    },
    "connector" : {
        "type" : "api",
        "api" : {
            "type" : "graphql",
            "endpoint" : {
                "type" : "dinamic",
                "base" : "https://%s.myshopify.com/admin/api/2026-07/graphql.json",
                "metadata_key": "shop"
            },
            "graphql":{
                "data": {
                    "path" : "data.orders.edges",
                    "is_array": true    
                },
                "authentication" : {
                    "type" : "header",
                    "param_name" : "X-Shopify-Access-Token"
                },   
                "pagination": {
                    "has_more_path": "data.orders.pageInfo.hasNextPage",
                    "cursor_path" : "data.orders.pageInfo.endCursor"  
                }
            }
                
        },
        "retry": {
            "max_retries": 3,
            "backoff_ms": 500,
            "max_backoff" : 500
        },
        "streams":[
            {
                "id" : "orders",
                "query": "query { orders(first: 10) { edges { cursor node { id } } pageInfo { hasNextPage hasPreviousPage startCursor endCursor } } }",
                "transformers" : [{ 
                    "type":"extractor", 
                    "extractor":{
                        "fields": "default"
                    }
                }
                ],
                "destination" : {
                    "name" :  "SHOPIFY_ORDERS",
                    "keys" : "id",
                    "schema": "default"
                },
                "fields_specs" : {
                    "default":{
                        "id": { "path": "id", "type": "string","required" : true, "default": null }
                    }
                } 
            }
        ]
    },
    "sink" : {
        "type" : "postgres",
        "batch_size" : 10,
        "retry": {
            "max_retries": 3,
            "backoff_ms": 500,
            "max_backoff" : 500
        },
        "schema" : {
            "auto_create" : true       
        },
        "source" : "source1"
    }
}
