{
  "connector" : {
    "type" : "mocked_rest",
    "retry": {
      "max_retries": 3,
      "backoff_ms": 500,
      "max_backoff" : 500
    },
    "mocked_rest":{
      "data": {
        "path" : "data",
        "is_array": true    
      },  
      "pagination": {
        "type": "cursor",
        "request": {
          "param": "after"
        },
        "response": {
          "next": {
            "path": "paging.cursors.after"
          }
        }
      },
      "response_paths" : [
        "./testdata/fb_ad_insights/response_page_1_action_product_id.json",
        "./testdata/fb_ad_insights/response_page_2_action_product_id.json"
      ]
    }
  },
  "sink" : {
    "type" : "memory",
    "batch_size" : 10,
    "retry": {
      "max_retries": 3,
      "backoff_ms": 500,
      "max_backoff" : 500
    }
  },  
  "runtime": {
    "pipeline_id" : "homysur_facebook_ads",
    "state_store": {
      "type" : "memory"
    }
  }
}
