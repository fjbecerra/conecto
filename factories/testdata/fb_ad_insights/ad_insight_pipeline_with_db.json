{
  "connector" : {
    "type" : "mocked_rest",
    "retry": {
      "max_retries": 3,
      "backoff_ms": 500,
      "max_backoff" : 500
    },
    "mocked_rest":{
      "data": {
        "path" : "data",
        "is_array": true    
      },  
      "pagination": {
        "type": "cursor",
        "request": {
          "param": "after"
        },
        "response": {
          "next": {
            "path": "paging.cursors.after"
          }
        }
      },
      "response_paths" : [
        "./testdata/fb_ad_insights/response_page_1_action_product_id.json",
        "./testdata/fb_ad_insights/response_page_2_action_product_id.json"
      ]
    }
  },
  "transformers" : [
    { 
      "type":"extractor", 
      "extractor":{
        "fields": "default"
      }
    }
  ],
  "sink" : {
    "type" : "postgres",
    "batch_size" : 10,
    "retry": {
      "max_retries": 3,
      "backoff_ms": 500,
      "max_backoff" : 500
    },
    "schema" : {
        "table" : "FB_AD_INSIGHTS_PRODUCT",
        "fields_specs" : "default",
        "upsert" : "product_id,date_start,pipeline_id",
        "auto_create" : true       
    } 
  },
  
  "fields_specs" : {
    "default":{
        "spend": { "path": "spend", "type": "float","required" : false, "default": 0.0 },
        "clicks": { "path": "clicks", "type": "int64", "required" : false, "default": 0 },
        "impressions": { "path": "impressions", "type": "int64", "required" : false, "default": 0 },
        "product_id": { "path": "product_id", "type": "int64", "required" : false, "default": 0 },
        "date_start": { "path": "date_start", "type": "time", "required" : false, "default": null }
      }
  },
  "database": {
      "dsn" : "postgres://username:password@localhost:5432/database_name?sslmode=disable"         
  },
  "runtime": {
    "pipeline_id" : "homysur_facebook_ads",
    "state_store": {
      "type" : "postgres",
      "name" : "pipeline_state",
      "auto_create": true
    }
  }
}
