{
  "source" : {
    "type" : "rest",
    "rest" :{
      "base_url": "xxx",
      "authentication" : {
        "type" : "query",
        "paramName" : "access_token"
      },
      "data": {
        "path" : "data",
        "is_array": true      
      },  
      "pagination": {
        "type": "cursor",
        "request": {
          "param": "after"
        },
        "response": {
          "next": {
            "path": "paging.cursors.after"
          }
        }
      }
    }
  },
  "transforms" : [
    { 
      "type":"extractor",
      "extractor": { 
        "fields": "fields_config"
      },
      "workers" : 5
    }
  ],
  "sink" : {
    "type" : "rdbs",
    "rdbs" : {
        "db_type" : "postgres",
        "dsn" : "",
        "table" : "",
        "schema" : "fields_config",
        "batch_size" : 10
    } 
  },

  "additional_configs": {
    "fields_config" : {
      "spend": { "path": "spend", "type": "float","required" : false, "default": 0 },
      "clicks": { "path": "clicks", "type": "int", "required" : false, "default": 0 },
      "impressions": { "path": "impressions", "type": "int", "required" : false, "default": 0 }
    }
  }

}
