{
  "source" : {
    "type" : "rest",
    "rest" :{
      "base_url": "xxx",
      "authentication" : {
        "type" : "query",
        "paramName" : "access_token"
      },
      "data": {
        "path" : "data",
        "is_array": true      
      },  
      "pagination": {
        "type": "cursor",
        "request": {
          "param": "after"
        },
        "response": {
          "next": {
            "path": "paging.cursors.after"
          }
        }
      }
    }
  },
  "transforms" : [
    { 
      "type":"extractor",
      "extractor": { 
        "fields": {
          "spend": { "path": "spend", "type": "float", "default": 0 },
          "clicks": { "path": "clicks", "type": "int", "default": 0 },
          "impressions": { "path": "impressions", "type": "int", "default": 0 }
        }
      },
      "workers" : 5
    }
  ],
  "sink" : {
    "type" : "sink_memory"    
  }
}
